rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección de listas de compras
    match /shoppingLists/{listId} {
      
      // Leer: solo si eres owner O estás en sharedWith
      allow read: if request.auth != null && 
        (resource.data.owner == request.auth.uid || 
         request.auth.token.email in resource.data.sharedWith);
      
      // Crear: solo si estás autenticado y eres el owner
      allow create: if request.auth != null &&
                   request.resource.data.owner == request.auth.uid;
      
      // Actualizar: solo si eres owner O colaborador
      allow update: if request.auth != null &&
        (resource.data.owner == request.auth.uid || 
         request.auth.token.email in resource.data.sharedWith);
      
      // Eliminar: solo si eres el owner
      allow delete: if request.auth != null &&
                   resource.data.owner == request.auth.uid;
    }
    
    // Colección de links compartidos (opcional, para futuro)
    match /shareLinks/{linkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
